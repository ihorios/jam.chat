# Copy to .env and fill in. Anything already set in the real environment wins,
# so a hosted deploy (Render, etc.) is configured there instead of here.

# --- Core ---------------------------------------------------------------
# Signs the session cookie. Without a stable value every restart logs everyone
# out, and two instances reject each other's sessions.
SESSION_SECRET=

# Postgres. Absent, the app runs on an in-memory store that is emptied on exit.
#
# TLS is configured here and nowhere else — pg reads sslmode out of this
# string and it overrides anything the pool sets in code. Ask a hosted
# database for sslmode=verify-full: today `require` is treated as the same
# thing, but pg 9 will loosen it to "encrypt, verify nothing", which is a
# downgrade that arrives on an npm update rather than a deploy.
#
#   DB_STRING=postgresql://user:pass@host/db?sslmode=verify-full
DB_STRING=

PORT=3000
HOST=0.0.0.0

# The first account, holding the admin role — without one a fresh database has
# no way in, since self-registration is the only public write and it grants no
# roles. Seeded on boot only when the address is free, so an existing admin is
# never overwritten and a password change survives a restart.
#
# Both of these must be set or nothing is seeded: no credential is defaulted in
# code, because a password in the repository is one every deployment ships with.
# The password is held to the same rules as any other — 8+ characters, a letter,
# a digit and a symbol — and the seed is refused if it falls short.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional; defaults to "Admin".
# ADMIN_NAME=Admin

# --- Sign in with Google ------------------------------------------------
# Google is the identity provider; accounts, roles and the session cookie stay
# this application's. The browser signs in with Google, receives an ID token,
# and hands it to POST /api/auth/google, which verifies it against Google's
# published keys before starting a session of its own.
#
# Unset, the route is never mounted and the button is never rendered.
#
# One value, needed twice: the server reads GOOGLE_CLIENT_ID at boot and the
# client is compiled with VITE_GOOGLE_CLIENT_ID at build time. A client id is
# public — it is handed to every browser that loads the button — so this is not
# a secret. There is no client *secret* here at all: the browser does the
# sign-in and the server only ever verifies the result.
#
# From the Google Cloud console, APIs & Services > Credentials > OAuth 2.0
# Client ID (type: Web application). Add every origin the app is served from to
# "Authorised JavaScript origins":
#   http://localhost:5173   `npm run dev`
#   http://localhost:3000   `npm start`
#   https://your-app.onrender.com
# No redirect URI is needed — this flow never leaves the page.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Calls --------------------------------------------------------------
# Calls work with nothing set here: browsers negotiate over public STUN, which
# is enough on most home and mobile networks. The connections that fail are the
# ones with no direct path at all — symmetric NAT, strict corporate firewalls —
# and those need their audio relayed by a TURN server.
#
# Relaying costs bandwidth, so TURN credentials are worth stealing. Prefer the
# shared-secret form: the server mints a username and password that expire
# (coturn's `use-auth-secret`, the TURN REST API most managed providers speak),
# so a credential taken out of a browser is worth an hour rather than forever.
# The secret itself never leaves the server.
#
#   TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
#   TURN_SECRET=the-same-secret-coturn-was-started-with
#   TURN_TTL_SECONDS=3600
#
# A provider that issues one fixed pair instead. It works, but every browser
# that has ever called holds a credential that never expires.
#
#   TURN_USERNAME=
#   TURN_PASSWORD=

# Override the public STUN servers, if you would rather not use Google's.
# STUN_URLS=stun:stun.example.com:3478

# How long an unanswered call rings before it gives up.
CALL_RING_SECONDS=40

# --- Attachments --------------------------------------------------------
# With nothing set here, uploads go to ./.files on this machine's disk. That is
# fine for development and for the tests, and wrong for a deployment: a
# container's disk does not survive a redeploy, and two instances would each
# hold half the attachments.
#
# For anything real, point these at an S3-compatible bucket — Neon Object
# Storage, Cloudflare R2, Backblaze B2, MinIO. The names are the AWS-standard
# ones so the AWS CLI and this server can be pointed at the same bucket from
# the same file, which is what makes a smoke test with `aws s3 cp` prove
# something about the app.
#
#   AWS_ENDPOINT_URL_S3=https://…
#   AWS_REGION=us-east-2
#   AWS_ACCESS_KEY_ID=…
#   AWS_SECRET_ACCESS_KEY=…
#   S3_BUCKET=chatty-files
#
# The bucket must be private. Every download is proxied through this server so
# that leaving a group ends access to its attachments; a public bucket would
# hand out URLs that outlive the membership that justified them.

# Force it either way, rather than inferring from whether a bucket is set.
# FILE_PROVIDER=s3

# <endpoint>/<bucket>/<key> addressing. Most non-AWS services want this;
# set to false for <bucket>.<endpoint>/<key>.
# S3_FORCE_PATH_STYLE=true

# Where the local provider keeps its objects, when no bucket is configured.
# FILE_DIR=.files

FILE_MAX_BYTES=5242880
FILE_MAX_PER_MESSAGE=3
# FILE_ALLOWED_EXTENSIONS=png,jpg,pdf,txt

# How long a file may exist attached to nothing before the sweep collects it.
FILE_SWEEP_GRACE_SECONDS=3600

# --- Flood control ------------------------------------------------------
# On by default, counted in this process's memory. One policy per thing worth
# protecting, because the right number is not the same for all of them: a
# hundred requests in five minutes is nothing for somebody using the app and a
# great deal for somebody guessing passwords.
#
# Each policy takes <NAME>_RATE_LIMIT_MAX and <NAME>_RATE_LIMIT_WINDOW_SECONDS.
# The defaults are:
#
#   LOGIN     10 per 300s   per address — every attempt costs a bcrypt compare
#   REGISTER   5 per 3600s  per address — public, and it creates rows
#   UPLOAD    30 per 300s   per account — 3 x 5MB a time adds up
#   SIGNAL   600 per 60s    per socket  — call frames are bursty by nature
#   API      600 per 300s   per address — the catch-all guard over /api
#
# RATE_LIMIT_ENABLED=false
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# How many proxies sit in front of this server. Behind Render's load balancer
# every request appears to come from one address, so without this the limiter
# would put every user in the same bucket. Defaults to 1 in production and to
# none locally. One hop rather than all of them: trusting the whole
# X-Forwarded-For chain lets a client pick its own bucket.
# TRUST_PROXY=1
